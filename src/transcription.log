da.io/@active-inference-institute/livestreams', 'episode': '2', 'filename': 'qztkjHf2g3g.wav', 'from_coda_csv': True, 'github': 'https://github.com/ActiveInferenceInstitute/ActiveInferenceJournal/tree/main/Livestream/LiveStream_057', 'guests': 'Thomas Parr', 'id': RecordID(table_name=session, record_id=z6gxbgx85lk9ihcjbm7h), 'metadata_filename': 'LiveStream_057.2_qztkjHf2g3g.simple.txt', 'other_participants': 'Chris Bennett,Daniel Friedman', 'published_at': datetime.datetime(2024, 6, 5, 5, 2, 53, tzinfo=datetime.timezone.utc), 'scheduled_date': datetime.datetime(2024, 6, 4, 8, 0, tzinfo=datetime.timezone.utc), 'series': 'LiveStream_057', 'session_name': 'qztkjHf2g3g', 'slides_url': '', 'thumbnails': 'https://i.ytimg.com/vi/qztkjHf2g3g/mqdefault.jpg', 'title': 'Active Inference LiveStream 057.2 ~ Active Data Selection and Information Seeking', 'transcribed': True, 'transcript_method': 'WhisperX', 'url': 'https://www.youtube.com/watch?v=qztkjHf2g3g', 'wav_extracted': True}]
