Juan Diego Bogotá', 'id': RecordID(table_name=session, record_id=ys3n3optilgbaup5lo5h), 'other_participants': 'Daniel Friedman', 'published_at': datetime.datetime(2024, 4, 4, 4, 35, 30, tzinfo=datetime.timezone.utc), 'scheduled_date': datetime.datetime(2024, 4, 3, 8, 0, tzinfo=datetime.timezone.utc), 'series': 'GuestStream_078', 'session_name': 'BcepTxAv_xI', 'slides_url': '', 'thumbnails': 'https://i.ytimg.com/vi/BcepTxAv_xI/mqdefault.jpg', 'title': 'ActInf GuestStream 078.1 ~ Juan Diego Bogotá: "What could come before time?"', 'transcribed': True, 'transcript_method': 'WhisperX', 'url': 'https://www.youtube.com/watch?v=BcepTxAv_xI', 'wav_extracted': True}]
