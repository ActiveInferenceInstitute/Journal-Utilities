tps://activeinference.org/ \nTwitter: https://twitter.com/InferenceActive \nDiscord: https://discord.gg/8VNKNp4jtx \nYouTube: https://www.youtube.com/c/ActiveInference/ \nActive Inference Livestreams: https://coda.io/@active-inference-institute/livestreams', 'episode': '1', 'filename': '3iY8ICcmd2E.wav', 'from_coda_csv': True, 'github': '', 'guests': 'Thomas Varley', 'id': RecordID(table_name=session, record_id=bc38qmiueab3ovpzl4qs), 'other_participants': 'Daniel Friedman', 'published_at': datetime.datetime(2024, 3, 30, 2, 38, 24, tzinfo=datetime.timezone.utc), 'scheduled_date': datetime.datetime(2024, 3, 29, 8, 0, tzinfo=datetime.timezone.utc), 'series': 'MathStream_010', 'session_name': '3iY8ICcmd2E', 'slides_url': '', 'thumbnails': 'https://i.ytimg.com/vi/3iY8ICcmd2E/mqdefault.jpg', 'title': 'ActInf MathStream 010.1 ~ Thomas Varley "Generalized decomposition of multivariate information"', 'transcribed': True, 'transcript_method': 'WhisperX', 'url': 'https://www.youtube.com/watch?v=3iY8ICcmd2E', 'wav_extracted': True}]
