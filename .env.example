# =============================================================================
# Journal Utilities - Environment Configuration
# =============================================================================
# This file contains all environment variables needed for both the transcription
# pipeline (WhisperX) and entity extraction pipeline (JournalRAG/Cohere)
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=Journal-Utilities
VERSION=0.1.0
DEBUG=False

# -----------------------------------------------------------------------------
# Transcription Pipeline (WhisperX)
# -----------------------------------------------------------------------------
# Hugging Face token for WhisperX models
# Get from: https://huggingface.co/settings/tokens
# Required models: pyannote/segmentation-3.0, pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=your_huggingface_token_here

# YouTube Data API v3 Key
# Get from: https://console.developers.google.com/apis/
API_KEY=your_youtube_api_key_here

# YouTube Channel ID for the Active Inference Institute
# Channel URL: https://www.youtube.com/channel/UCbPq2w41ZaJSWtpCq4BE6Dg
YOUTUBE_CHANNEL_ID=UCbPq2w41ZaJSWtpCq4BE6Dg

# Coda API Token for fetching session data
# Get from: https://coda.io/account (API settings section)
CODA_API_TOKEN=your_coda_api_token_here

# Directory paths for transcription pipeline
WAV_DIRECTORY=/mnt/docs/actinf/activeinference
OUTPUT_DIR=/mnt/md0/projects/Journal-Utilities/data/output
JOURNAL_REPO_DIR=/mnt/md0/projects/ActiveInferenceJournal

# -----------------------------------------------------------------------------
# Entity Extraction Pipeline (JournalRAG/Cohere)
# -----------------------------------------------------------------------------
# Cohere API Configuration for entity extraction
# Get from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-a-03-2025

# Processing settings for entity extraction
BATCH_SIZE=10
MAX_RETRIES=3

# -----------------------------------------------------------------------------
# SurrealDB Configuration (Shared by both pipelines)
# -----------------------------------------------------------------------------
# Database connection settings
# Note: Journal-Utilities uses DB_* prefix, JournalRAG uses SURREALDB_* prefix
# Both are supported for backwards compatibility

# Primary configuration (used by journal_utilities)
DB_URL=ws://0.0.0.0:8080/rpc
DB_USER=root
DB_PASSWORD=root
DB_NAME=actinf
DB_NAMESPACE=actinf

# Alternative configuration (used by journalrag)
# Set to same values as above for consistency
SURREALDB_URL=ws://0.0.0.0:8080/rpc
SURREALDB_USERNAME=root
SURREALDB_PASSWORD=root
SURREALDB_DATABASE=actinf
SURREALDB_NAMESPACE=actinf
